<?xml version="1.0"?>
<package format="3">
  <name>kuka_launch</name>
  <version>0.0.0</version>
  <description>The kuka_launch package</description>
  <maintainer email="valentin@todo.todo">valentin</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- single_lwr.launch.py -->
  <exec_depend>single_lwr_robot</exec_depend>
  <exec_depend>single_lwr_launch</exec_depend>
  <exec_depend>single_lwr_moveit</exec_depend>
  <exec_depend>lwr_hw</exec_depend>
  <exec_depend>lwr_controllers</exec_depend>
  <exec_depend>kuka_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- impedance_simulation.launch.py; force_models, kuka_stiffness_estimation and
       kuka_impedance_controller have no ROS 2 version (see MIGRATION_NOTES) -->
  <exec_depend>kuka_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
