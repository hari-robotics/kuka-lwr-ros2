  <!-- ROS 2: liblwr_hw_gazebo_plugin.so + gazebo references + SimpleTransmission
       -> gz_ros2_control + ros2_control (lwr_description macros) -->
  <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
    <xacro:kuka_lwr_gazebo name="lwr"/>
  </xacro:if>
  <xacro:if value="${'$(arg ros2_control_hardware_type)' != 'none'}">
    <xacro:kuka_lwr_ros2_control name="lwr"/>
  </xacro:if>
  <!-- Create a fixed joint with a parameterized name. -->
  <joint name="tool_joint" type="fixed">
    <!-- The parent link must be read from the robot model it is attached to. -->
    <parent link="lwr_7_link"/>
    <child link="tool"/>
    <!-- The tool is directly attached to the flange. -->
    <origin rpy="0 0 0" xyz="0 0 0.0275"/>
  </joint>
  <link name="tool">
    <visual>
      <geometry>
        <cylinder length="0.11" radius="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.11" radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <joint name="ee_tool_joint" type="fixed">
    <!-- The parent link must be read from the robot model it is attached to. -->
    <parent link="tool"/>
    <child link="tool_ee"/>
    <!-- The tool is directly attached to the flange. -->
    <origin rpy="0 0 0" xyz="0 0 0.055"/>
  </joint>
  <link name="tool_ee">
    <visual>
      <geometry>
        <cylinder length="0.11" radius="0.005"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.005"/>
      </geometry>
    </collision>
  </link>
  <!-- TCP frame -->
  <joint name="tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.116"/>
    <parent link="tool_ee"/>
    <child link="tcp"/>
  </joint>
  <link name="tcp"/>
  <!-- define the ur5's position and orientation in the world coordinate system -->
  <link name="world"/>
  <!-- ROS 2: lwr_base_link already has the parent joint world_lwr_base_joint (same transform).
       Gazebo Fortress duplicates the whole subtree for the second parent joint and refuses
       the model, so this joint is left out of the Gazebo description only. -->
  <xacro:if value="${'$(arg ros2_control_hardware_type)' != 'gazebo'}">
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="lwr_base_link"/>
    <!-- TODO: check base_link name of robot -->
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  </xacro:if>
