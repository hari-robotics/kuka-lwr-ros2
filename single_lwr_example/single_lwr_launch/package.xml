<?xml version="1.0"?>
<package format="3">
  <name>single_lwr_launch</name>
  <version>0.1.0</version>
  <description>The single_lwr_launch package to control everything that needs to launched.</description>
  <maintainer email="marco.esposito@tum.de">Marco Esposito</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>single_lwr_robot</depend>
  <exec_depend>single_lwr_moveit</exec_depend>
  <exec_depend>cartesian_position_node</exec_depend>
  <exec_depend>rqt_controller_manager</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <depend>lwr_controllers</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
</package>
